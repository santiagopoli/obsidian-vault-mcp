{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "obsidian-vault-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_GITHUB_USER_ID": "12345678",
    "GITHUB_REPOSITORIES": "example-user/example-vault",
    "VAULT_ACCESS": "read",
    "OMIT_AUTHORIZATION_RESPONSE_ISS": "false",
    "GITHUB_WEBHOOK_HOOK_ID": "123456789",
    "GITHUB_WEBHOOK_REPOSITORY_ID": "123456789",
    "GITHUB_WEBHOOK_DEFAULT_BRANCH": "main",
    "GITHUB_WEBHOOK_VAULT": "example-user/example-vault",
    "OPENAI_CHAT_MODEL": "gpt-5.6-sol",
    "WEB_CHAT_ENABLED": "false",
    "WEB_CHAT_DAILY_LIMIT": "50",
    "GOOGLE_CLIENT_ID": "",
    "AUTOMATIONS_YAML": "version: 1\nautomations: []\n"
  },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "secrets": {
    "required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "GITHUB_VAULT_TOKEN", "GITHUB_WEBHOOK_SECRET"]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "d1_databases": [
    {
      "binding": "EVENT_DB",
      "database_name": "obsidian-vault-events",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "EVENTS_QUEUE", "queue": "obsidian-vault-events" },
      { "binding": "AUTOMATIONS_QUEUE", "queue": "obsidian-vault-automations" }
    ],
    "consumers": [
      {
        "queue": "obsidian-vault-events",
        "max_batch_size": 10,
        "max_retries": 5,
        "max_concurrency": 1,
        "dead_letter_queue": "obsidian-vault-events-dlq"
      },
      {
        "queue": "obsidian-vault-automations",
        "max_batch_size": 1,
        "max_retries": 5,
        "max_concurrency": 2,
        "dead_letter_queue": "obsidian-vault-automations-dlq"
      }
    ]
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
